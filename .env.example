# Operator credentials for the CLI scripts. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored — this repo is public, and two of these are secrets.
# Only the operator scripts read it (draw, update-participant, reveal, forget,
# nudge, remind); `next dev` and the tests do not.
#
# ─────────────────────────────────────────────────────────────────────────────
# THESE TWO DECIDE WHETHER YOU ARE TOUCHING THE LIVE EVENT.
#
# Set together, every script reads and writes the real Netlify Blobs store.
# Leave both unset and everything works on `data/event.local.json` instead —
# which is what you want for a rehearsal you do not trust yet. Setting only one
# is a misconfiguration and fails loudly rather than silently falling back.
#
# Every script prints which of the two it resolved, on every run. Read that
# line before you type `--yes`.
#
# NEVER set these two in Netlify's own environment variables. The deployed site
# is handed Blobs credentials automatically; these are for your terminal only,
# and NETLIFY_AUTH_TOKEN is account-wide.
# ─────────────────────────────────────────────────────────────────────────────

# Netlify UI → Project configuration → General → Project ID.
NETLIFY_SITE_ID=

# Netlify UI → user avatar → User settings → Applications → Personal access
# tokens. Account-wide: treat it like a password.
NETLIFY_AUTH_TOKEN=

# Postgres, for the sign-ups the form writes. The database is the draw's
# default source, so without this `npm run draw` cannot read anybody.
# Netlify UI → Data & Storage → Database.
NETLIFY_DB_URL=

# Used to print the private links after a real draw. Without it they come out
# as http://localhost:3000/s/<token>, which is not much use in an email.
SITE_URL=https://former-fab-players-winter-exchange-26.netlify.app

# Only for posting from the CLI (`npm run nudge`, `npm run remind`). The
# scheduled functions read this from Netlify, not from here — so you only need
# it locally if you want to preview or force a post.
# Discord → Server Settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=
